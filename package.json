{
  "name": "script-mc-launcher",
  "version": "0.24.0",
  "type": "module",
  "description": "Custom modern Minecraft launcher with instance isolation and mod loader support",
  "author": "Sreeraj SK",
  "license": "MIT",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.web.json",
    "test": "npm run test:rust",
    "release:tauri": "node scripts/release-tauri.mjs",
    "dev:renderer": "vite",
    "tauri:dev": "tauri dev",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "dompurify": "^3.2.6",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
